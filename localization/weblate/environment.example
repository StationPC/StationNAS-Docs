WEBLATE_DEBUG=0
WEBLATE_LOGLEVEL=INFO
WEBLATE_SITE_TITLE=StationOS Pro Localization
WEBLATE_ADMIN_NAME=Localization Admin
WEBLATE_ADMIN_EMAIL=admin@example.com
WEBLATE_ADMIN_PASSWORD=replace-with-a-long-random-password
WEBLATE_SERVER_EMAIL=weblate@example.com
WEBLATE_DEFAULT_FROM_EMAIL=weblate@example.com
WEBLATE_ALLOWED_HOSTS=translate.example.com
WEBLATE_REGISTRATION_OPEN=0
WEBLATE_REQUIRE_LOGIN=1
WEBLATE_TIME_ZONE=Asia/Shanghai

# Uncomment when TLS terminates at a reverse proxy.
# WEBLATE_ENABLE_HTTPS=1
# WEBLATE_IP_PROXY_HEADER=HTTP_X_FORWARDED_FOR
# WEBLATE_SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_USER=weblate
POSTGRES_DB=weblate
POSTGRES_HOST=database
POSTGRES_PORT=
POSTGRES_DATABASE=weblate

REDIS_HOST=cache
REDIS_PORT=6379

WEBLATE_EMAIL_HOST=smtp.example.com
WEBLATE_EMAIL_HOST_USER=
WEBLATE_EMAIL_HOST_PASSWORD=

# Optional GitHub sign-in.
# WEBLATE_SOCIAL_AUTH_GITHUB_KEY=
# WEBLATE_SOCIAL_AUTH_GITHUB_SECRET=

