{
  "name": "stationospro_help",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "i18n:check": "node scripts/i18n.mjs check",
    "i18n:check:release": "I18N_REQUIRE_APPROVED_HIGH_RISK=1 node scripts/i18n.mjs check",
    "i18n:extract": "node scripts/i18n.mjs extract",
    "i18n:render": "node scripts/i18n.mjs render",
    "i18n:sync": "node scripts/i18n.mjs sync",
    "i18n:test": "node --test scripts/i18n.test.mjs",
    "start": "next start",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "fumadocs-core": "16.9.3",
    "fumadocs-mdx": "15.0.10",
    "fumadocs-ui": "16.9.3",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.15",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "yaml": "^2.9.0"
  }
}
